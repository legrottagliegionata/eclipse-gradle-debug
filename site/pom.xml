<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The only module with a POM: the update site is the one signed with PGP. -->
    <parent>
        <groupId>io.github.legrottagliegionata</groupId>
        <artifactId>gradle-task-debugger</artifactId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>site</artifactId>
    <packaging>eclipse-repository</packaging>
    <name>Gradle Task Debugger for Eclipse - Update Site</name>

    <build>
        <plugins>
            <!-- A page for the people who open the address of the update site in a browser. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>landing-page</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/repository</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>pages</directory>
                                    <filtering>true</filtering>
                                </resource>
                                <resource>
                                    <directory>../docs</directory>
                                    <includes>
                                        <include>logo.svg</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            PGP signature of the update site, used by the release build: -Psign, with the secret
            key imported in the gpg keyring and its passphrase in MAVEN_GPG_PASSPHRASE.
        -->
        <profile>
            <id>sign</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.eclipse.tycho</groupId>
                        <artifactId>tycho-gpg-plugin</artifactId>
                        <version>${tycho.version}</version>
                        <executions>
                            <execution>
                                <id>pgp-sign</id>
                                <goals>
                                    <goal>sign-p2-artifacts</goal>
                                </goals>
                                <configuration>
                                    <useAgent>false</useAgent>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
