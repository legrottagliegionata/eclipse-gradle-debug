<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The only module with a POM: the update site is the one signed with PGP. -->
    <parent>
        <groupId>io.github.legrottagliegionata</groupId>
        <artifactId>gradle-task-debugger</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>site</artifactId>
    <packaging>eclipse-repository</packaging>
    <name>Gradle Task Debugger for Eclipse - Update Site</name>

    <profiles>
        <!--
            PGP signature of the update site, used by the release build: -Psign with the armored
            secret key in MAVEN_GPG_KEY and its passphrase in MAVEN_GPG_PASSPHRASE.
        -->
        <profile>
            <id>sign</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.eclipse.tycho</groupId>
                        <artifactId>tycho-gpg-plugin</artifactId>
                        <version>${tycho.version}</version>
                        <executions>
                            <execution>
                                <id>pgp-sign</id>
                                <goals>
                                    <goal>sign-p2-artifacts</goal>
                                </goals>
                                <configuration>
                                    <signer>bc</signer>
                                    <useAgent>false</useAgent>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
